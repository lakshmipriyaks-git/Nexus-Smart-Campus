rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Authentication & Role Helper Functions ---
    function isAuthenticated() {
      return request.auth != null; 
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isStaffOrTeacher() {
      return isAuthenticated() && (getUserRole() == 'teacher' || getUserRole() == 'staff');
    }

    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }

    function isHod() {
      return isAuthenticated() && getUserRole() == 'hod';
    }

    function isDriver() {
      return isAuthenticated() && getUserRole() == 'driver';
    }

    function isAdminLibrary() {
      return isAuthenticated() && getUserRole() == 'admin_library';
    }

    function isAdminXerox() {
      return isAuthenticated() && getUserRole() == 'admin_xerox';
    }

    function isAdminCanteen() {
      return isAuthenticated() && getUserRole() == 'admin_canteen';
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isHod() || (
        isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || 
          request.resource.data.role == resource.data.role
        )
      );
      allow delete: if isHod();

      // Subcollections: Personal Tasks & Calendar Events
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId) || isHod();
      }

      match /events/{eventId} {
        allow read, write: if isOwner(userId) || isHod();
      }

      // Subcollection: Student-Specific Attendance Records Projection
      match /attendanceRecords/{sessionId} {
        allow read: if isOwner(userId) || isStaffOrTeacher() || isHod();
        allow write: if isStaffOrTeacher() || isHod();
      }

      // Subcollection: Student-Specific Tracked Anonymous Complaints
      match /trackedComplaints/{complaintId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- Classes Collection ---
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isStaffOrTeacher() || isHod();
      allow update: if (isStaffOrTeacher() && resource.data.teacherId == request.auth.uid) || isHod();
      allow delete: if (isStaffOrTeacher() && resource.data.teacherId == request.auth.uid) || isHod();
    }

    // --- Courses Collection ---
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isStaffOrTeacher() || isHod();
      allow update: if (isStaffOrTeacher() && (resource.data.teacherId == request.auth.uid || isOwner(get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherId))) || isHod();
      allow delete: if (isStaffOrTeacher() && resource.data.teacherId == request.auth.uid) || isHod();
    }

    // --- Join Requests ---
    match /joinRequests/{requestId} {
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow get: if isOwner(resource.data.studentId) || isStaffOrTeacher() || isHod();
      allow list: if isAuthenticated();
      allow update: if isStaffOrTeacher() || isHod();
      allow delete: if isHod();
    }

    // --- Authoritative Attendance Records ---
    match /attendance/{recordId} {
      // Authoritative class sessions accessible only to faculty and HOD
      // Students query their own users/{uid}/attendanceRecords projection
      allow read, write: if isStaffOrTeacher() || isHod();
    }

    // --- Grades ---
    match /grades/{gradeId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrTeacher() || isHod();
    }

    // --- Assessments ---
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrTeacher() || isHod();
    }

    // --- Resources (including Chunks) ---
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrTeacher() || isHod();
      
      match /chunks/{chunkId} {
        allow read: if isAuthenticated();
        allow write: if isStaffOrTeacher() || isHod();
      }
    }

    // --- Announcements ---
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrTeacher() || isHod();
    }

    // --- Interventions (Meetings & Action Plans) ---
    match /interventions/{interventionId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrTeacher() || isHod();
    }

    // --- Preference Forms (Created by HOD) ---
    match /preferenceForms/{formId} {
      allow read: if isAuthenticated();
      allow write: if isHod();
    }

    // --- Subject Preferences (Teacher Submissions) ---
    match /subjectPreferences/{formId} {
      allow read: if isHod() || (isStaffOrTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isStaffOrTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isHod() || (isStaffOrTeacher() && resource.data.teacherId == request.auth.uid && resource.data.status != 'locked');
      allow delete: if isHod();
    }

    // ==========================================
    // --- CAMPUS UTILITY SERVICES COLLECTIONS ---
    // ==========================================

    // --- Bus Fleet Tracking ---
    match /buses/{busId} {
      allow read: if isAuthenticated();
      allow write: if isDriver() || isHod() || isStaffOrTeacher();
    }

    // --- Digital Library Books ---
    match /libraryBooks/{bookId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdminLibrary() || isHod();
      allow update: if isAdminLibrary() || isHod() || isAuthenticated();
    }

    // --- Library Borrowings ---
    match /libraryBorrowings/{borrowingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdminLibrary() || isHod() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdminLibrary() || isHod();
    }

    // --- Smart Canteen Daily Menu ---
    match /canteenMenu/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdminCanteen() || isHod();
    }

    // --- Smart Canteen Kitchen Orders ---
    match /canteenOrders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdminCanteen() || isHod() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdminCanteen() || isHod();
    }

    // --- Print Hub & Xerox Desk Jobs ---
    match /printJobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdminXerox() || isHod() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdminXerox() || isHod();
    }

    // --- Campus Events ---
    match /campusEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrTeacher() || isHod();
    }

    // --- Event Registrations & RSVP Passes ---
    match /eventRegistrations/{regId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isStaffOrTeacher() || isHod() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // --- Campus Complaints & Grievance Portal ---
    match /campusComplaints/{complaintId} {
      // Direct document get: student can access their own, or an anonymous complaint they tracked
      allow get: if isAuthenticated() && (
        isHod() ||
        isStaffOrTeacher() ||
        resource.data.studentId == request.auth.uid ||
        (resource.data.isAnonymous == true && exists(/databases/$(database)/documents/users/$(request.auth.uid)/trackedComplaints/$(complaintId)))
      );
      // Query list: student can only list their non-anonymous complaints; reviewers list by dept/authority
      allow list: if isAuthenticated() && (
        isHod() ||
        isStaffOrTeacher() ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid ||
        (request.resource.data.isAnonymous == true && request.resource.data.studentId == 'anonymous')
      );
      allow update: if isHod() || isStaffOrTeacher() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow delete: if isHod();
    }

    // Legacy complaints collection alias
    match /complaints/{complaintId} {
      allow get: if isAuthenticated() && (
        isHod() ||
        isStaffOrTeacher() ||
        resource.data.studentId == request.auth.uid ||
        (resource.data.isAnonymous == true && exists(/databases/$(database)/documents/users/$(request.auth.uid)/trackedComplaints/$(complaintId)))
      );
      allow list: if isAuthenticated() && (
        isHod() ||
        isStaffOrTeacher() ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid ||
        (request.resource.data.isAnonymous == true && request.resource.data.studentId == 'anonymous')
      );
      allow update: if isHod() || isStaffOrTeacher() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow delete: if isHod();
    }

    // --- Campus Payments Audit Records ---
    match /campusPayments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isHod();
    }

    // --- System Notifications & Cross-Desk Broadcasts ---
    match /notifications/{notifId} {
      // Authenticated users can only read notifications specifically addressed to them
      // OR public announcements where targetUserId is null / empty
      // HODs maintain departmental administrative visibility
      allow read: if isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid ||
        resource.data.targetUserId == null ||
        resource.data.targetUserId == '' ||
        isHod()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid ||
        resource.data.targetUserId == null ||
        isHod()
      );
      allow delete: if isHod();
    }

    // --- Student Marks Upload Staging ---
    match /student_marks/{markId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrTeacher() || isHod();
    }
  }
}
