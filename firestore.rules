rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null; 
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isTeacher() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isStudent() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function isHod() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'hod';
    }

    // --- Users Collection ---
    // Users can read their own profile + other authenticated users can read for rosters/teacher lookup
    match /users/{userId} {
      // Allow all authenticated users to read user profiles (needed for class rosters, teacher lookup, etc.)
      allow read: if isAuthenticated() || isHod();
      
      // Allow creation only by the user themselves
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Regular users: can update their own profile but not change their role
      // HOD: can update any user (e.g. to approve/reject teachers by setting status)
      allow update: if isHod() ||
        (isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || 
          request.resource.data.role == resource.data.role
        ));
      
      // HOD can remove users (teachers/students). Regular users cannot delete.
      allow delete: if isHod();
    }

    // --- Classes Collection ---
    match /classes/{classId} {
      // Anyone can read classes (for catalog), or restrict to members if needed
      allow read: if isAuthenticated() || isHod();
      
      // Only teachers can create/update/delete classes
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if (isTeacher() && resource.data.teacherId == request.auth.uid) || isHod();
    }

    // --- Courses Collection ---
    match /courses/{courseId} {
      allow read: if isAuthenticated() || isHod();
      allow create: if isTeacher();
      allow update: if isTeacher() && (resource.data.teacherId == request.auth.uid || isOwner(get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherId));
      allow delete: if isTeacher();
    }

    // --- Join Requests ---
    match /joinRequests/{requestId} {
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      // 'get' (single doc): students can only read their own; teachers and HODs can read all
      allow get: if isOwner(resource.data.studentId) || isTeacher() || isHod();
      // 'list' (queries): teachers and HODs can list all; students use a query filtered by studentId
      allow list: if isTeacher() || isHod() || isStudent();
      allow update: if isTeacher() && isOwner(get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherId);
    }

    // --- Attendance ---
    match /attendance/{recordId} {
      // Students can read only their own attendance records
      // Note: This requires a specific data structure where studentId is a field, 
      // or we query by a subcollection. Assuming 'records' map structure in current app, 
      // row-level security is hard. Ideally, attendance should be a subcollection or separate docs per student.
      // For this mini-project structure:
      allow read: if isAuthenticated() || isHod(); 
      allow write: if isTeacher();
    }

    // --- Grades ---
    match /grades/{gradeId} {
      allow read: if isOwner(resource.data.studentId) || isTeacher() || isHod();
      allow write: if isTeacher();
    }

    // --- Assessments ---
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated() || isHod();
      allow write: if isTeacher();
    }

    // --- Resources (including Chunks) ---
    match /resources/{resourceId} {
      allow read: if isAuthenticated() || isHod();
      allow write: if isTeacher();
      
      match /chunks/{chunkId} {
        allow read: if isAuthenticated();
        allow write: if isTeacher();
      }
    }

    // --- Announcements ---
    match /announcements/{announcementId} {
      allow read: if isAuthenticated() || isHod();
      allow write: if isTeacher() || isHod();
    }

    // --- Interventions (Meetings & Action Plans) ---
    match /interventions/{interventionId} {
      allow read: if isAuthenticated() || isHod();
      allow create: if isTeacher();
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // --- Preference Forms (Created by HOD) ---
    match /preferenceForms/{formId} {
      // Any authenticated user can read
      allow read: if isAuthenticated();
      // Only HOD can create/update/delete
      allow write: if isHod();
    }

    // --- Subject Preferences (Teacher Submissions) ---
    match /subjectPreferences/{formId} {
      allow read: if isHod() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isHod() || 
        (isTeacher() && resource.data.teacherId == request.auth.uid && resource.data.status != 'locked');
      allow delete: if isHod();
    }
  }
}
