import React, { useState } from 'react';
import AnalyticsDashboard from '../components/teacher/AnalyticsDashboard';
import StudentRoster from '../components/teacher/StudentRoster';
import PostAnnouncement from '../components/teacher/PostAnnouncement';
import AssessmentManager from '../components/teacher/AssessmentManager';
import GradeEntry from '../components/teacher/GradeEntry';
import GradeAnalytics from '../components/teacher/GradeAnalytics';
import { useData } from '../context/DataContext';
import { useAuth } from '../context/AuthContext';

export default function TeacherDashboard() {
    const { user } = useAuth();
    const { classes, createClass, joinRequests, respondToJoinRequest, courses, createCourse, resources, addResource, addAnnouncement } = useData();
    const [newClassName, setNewClassName] = useState('');
    const [newClassDesc, setNewClassDesc] = useState('');
    const [selectedClassId, setSelectedClassId] = useState(null);
    const [selectedCourseId, setSelectedCourseId] = useState(null);

    const handleCreateClass = (e) => {
        e.preventDefault();
        if (!newClassName.trim()) return;

        createClass({
            name: newClassName,
            description: newClassDesc,
            teacherId: user.id,
            teacherName: user.name
        });
        setNewClassName('');
        setNewClassDesc('');
    };

    const myClasses = classes.filter(c => c.teacherId === user.id);
    const myRequests = joinRequests.filter(req =>
        myClasses.some(c => c.id === req.classId) && req.status === 'pending'
    );

    return (
        <div className="space-y-6">
            <AnalyticsDashboard />

            {/* Class & Course Management Section */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {/* Left: Create Class / Select Class */}
                <div className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                    <h2 className="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Class Management</h2>

                    <div className="mb-6">
                        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Select Class to Manage</label>
                        <select
                            className="w-full px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                            onChange={(e) => {
                                setSelectedClassId(e.target.value);
                                setSelectedCourseId(null);
                            }}
                            value={selectedClassId || ''}
                        >
                            <option value="">-- Select a Class --</option>
                            {myClasses.map(c => (
                                <option key={c.id} value={c.id}>{c.name}</option>
                            ))}
                        </select>
                    </div>

                    <div className="border-t pt-4">
                        <h3 className="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Create New Class (Group)</h3>
                        <form onSubmit={handleCreateClass} className="space-y-3">
                            <input
                                type="text"
                                value={newClassName}
                                onChange={(e) => setNewClassName(e.target.value)}
                                className="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                placeholder="e.g., AI&DS 5th Sem"
                            />
                            <textarea
                                value={newClassDesc}
                                onChange={(e) => setNewClassDesc(e.target.value)}
                                className="w-full px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                placeholder="Description..."
                                rows="2"
                            />
                            <button
                                type="submit"
                                className="w-full px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors"
                            >
                                Create Class
                            </button>
                        </form>
                    </div>
                </div>

                {/* Right: Course Management (visible if class selected) */}
                <div className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                    <h2 className="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Course Management</h2>
                    {!selectedClassId ? (
                        <p className="text-gray-500 text-center py-8">Select a class to manage courses.</p>
                    ) : (
                        <CourseManager
                            classId={selectedClassId}
                            courses={courses.filter(c => c.classId === selectedClassId)}
                            createCourse={createCourse}
                            onSelectCourse={setSelectedCourseId}
                            selectedCourseId={selectedCourseId}
                        />
                    )}
                </div>
            </div>

            {/* Course Content Editor (visible if course selected) */}
            {console.log('Selected Course ID:', selectedCourseId)}
            {selectedCourseId && (
                <CourseContentEditor
                    courseId={selectedCourseId}
                    courseName={courses.find(c => c.id === selectedCourseId)?.name}
                    resources={resources.filter(r => r.courseId === selectedCourseId)}
                    addResource={addResource}
                    addAnnouncement={addAnnouncement}
                    user={user}
                />
            )}

            {/* Join Requests */}
            <div className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                <h2 className="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Join Requests</h2>
                {myRequests.length === 0 ? (
                    <p className="text-gray-500 text-center py-4">No pending requests</p>
                ) : (
                    <div className="space-y-3">
                        {myRequests.map(req => {
                            const targetClass = myClasses.find(c => c.id === req.classId);
                            return (
                                <div key={req.id} className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                    <div>
                                        <p className="font-medium text-gray-800">{req.studentName}</p>
                                        <p className="text-sm text-gray-500">wants to join {targetClass?.name}</p>
                                    </div>
                                    <div className="flex space-x-2">
                                        <button
                                            onClick={() => respondToJoinRequest(req.id, 'approved')}
                                            className="px-3 py-1 text-sm bg-green-100 text-green-700 rounded-md hover:bg-green-200"
                                        >
                                            Accept
                                        </button>
                                        <button
                                            onClick={() => respondToJoinRequest(req.id, 'rejected')}
                                            className="px-3 py-1 text-sm bg-red-100 text-red-700 rounded-md hover:bg-red-200"
                                        >
                                            Reject
                                        </button>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                )}
            </div>

            {/* Attendance Management Section */}
            <div className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                <h2 className="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Attendance Management</h2>
                {myClasses.length === 0 ? (
                    <p className="text-gray-500">Create a class to start taking attendance.</p>
                ) : (
                    <AttendanceManager classes={myClasses} />
                )}
            </div>

            {/* Grading Management Section */}
            {selectedCourseId && (
                <div className="space-y-6">
                    <div className="bg-gradient-to-r from-purple-50 to-indigo-50 p-6 rounded-xl shadow-sm border border-purple-100">
                        <h2 className="text-xl font-bold text-purple-900 mb-2">
                            📊 Grading System - {courses.find(c => c.id === selectedCourseId)?.name}
                        </h2>
                        <p className="text-sm text-purple-700">
                            Create assessments, enter grades, and view analytics for this course.
                        </p>
                    </div>

                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <AssessmentManager
                            courseId={selectedCourseId}
                            courseName={courses.find(c => c.id === selectedCourseId)?.name}
                        />
                        <GradeEntry
                            courseId={selectedCourseId}
                            courseName={courses.find(c => c.id === selectedCourseId)?.name}
                        />
                    </div>

                    <GradeAnalytics
                        courseId={selectedCourseId}
                        courseName={courses.find(c => c.id === selectedCourseId)?.name}
                    />
                </div>
            )}

            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div className="lg:col-span-2">
                    <StudentRoster />
                </div>
                <div>
                    <PostAnnouncement />
                </div>
            </div>
        </div>
    );
}

function CourseManager({ classId, courses, createCourse, onSelectCourse, selectedCourseId }) {
    const [newCourseName, setNewCourseName] = useState('');
    const { user } = useAuth();

    const handleAddCourse = (e) => {
        e.preventDefault();
        if (!newCourseName.trim()) return;
        createCourse({
            classId,
            name: newCourseName,
            teacherId: user.id
        });
        setNewCourseName('');
    };

    return (
        <div className="space-y-4">
            <div className="space-y-2">
                {courses.map(course => (
                    <div
                        key={course.id}
                        onClick={() => onSelectCourse(course.id)}
                        className={`p-3 rounded-lg border cursor-pointer transition-colors ${selectedCourseId === course.id
                            ? 'border-indigo-500 bg-indigo-50'
                            : 'border-gray-200 hover:bg-gray-50'
                            }`}
                    >
                        <div className="font-medium text-gray-800">{course.name}</div>
                    </div>
                ))}
                {courses.length === 0 && <p className="text-sm text-gray-500 italic">No courses added yet.</p>}
            </div>

            <form onSubmit={handleAddCourse} className="flex gap-2 mt-4">
                <input
                    type="text"
                    value={newCourseName}
                    onChange={(e) => setNewCourseName(e.target.value)}
                    className="flex-1 px-3 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
                    placeholder="New Course Name (e.g. Math)"
                />
                <button
                    type="submit"
                    className="px-3 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm whitespace-nowrap"
                >
                    Add Course
                </button>
            </form>
        </div>
    );
}

function CourseContentEditor({ courseId, courseName, resources, addResource, addAnnouncement, user }) {
    const [resTitle, setResTitle] = useState('');
    const [resType, setResType] = useState('pdf');
    const [announcementText, setAnnouncementText] = useState('');

    const handleAddResource = (e) => {
        e.preventDefault();
        if (!resTitle.trim()) return;
        addResource({
            courseId,
            title: resTitle,
            type: resType,
            url: '#', // Mock URL
        });
        setResTitle('');
    };

    const handlePostAnnouncement = (e) => {
        e.preventDefault();
        if (!announcementText.trim()) return;
        addAnnouncement({
            id: Date.now(),
            title: `Announcement: ${courseName}`,
            content: announcementText,
            date: new Date().toISOString().split('T')[0],
            author: user.name,
            courseId
        });
        setAnnouncementText('');
        alert('Announcement posted!');
    };

    return (
        <div className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
            <h2 className="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Managing: {courseName}</h2>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                {/* Resources */}
                <div>
                    <h3 className="font-medium text-gray-700 mb-3">Resources</h3>
                    <ul className="space-y-2 mb-4">
                        {resources.map(r => (
                            <li key={r.id} className="flex items-center text-sm text-gray-600">
                                <span className={`w-2 h-2 rounded-full mr-2 ${r.type === 'pdf' ? 'bg-red-500' : 'bg-blue-500'}`}></span>
                                {r.title} ({r.type.toUpperCase()})
                            </li>
                        ))}
                        {resources.length === 0 && <li className="text-sm text-gray-400 italic">No resources.</li>}
                    </ul>
                    <form onSubmit={handleAddResource} className="space-y-2">
                        <input
                            type="text"
                            value={resTitle}
                            onChange={(e) => setResTitle(e.target.value)}
                            className="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm"
                            placeholder="Resource Title"
                        />
                        <select
                            value={resType}
                            onChange={(e) => setResType(e.target.value)}
                            className="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm"
                        >
                            <option value="pdf">PDF Document</option>
                            <option value="doc">Word Document</option>
                        </select>
                        <button type="submit" className="w-full px-3 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm hover:bg-gray-200">
                            Upload Resource
                        </button>
                    </form>
                </div>

                {/* Course Announcements */}
                <div>
                    <h3 className="font-medium text-gray-700 mb-3">Post Course Announcement</h3>
                    <form onSubmit={handlePostAnnouncement} className="space-y-2">
                        <textarea
                            value={announcementText}
                            onChange={(e) => setAnnouncementText(e.target.value)}
                            className="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm"
                            placeholder={`Message for ${courseName} students...`}
                            rows="4"
                        />
                        <button type="submit" className="w-full px-3 py-2 bg-indigo-600 text-white rounded-lg text-sm hover:bg-indigo-700">
                            Post Announcement
                        </button>
                    </form>
                </div>
            </div>
        </div>
    );
}

function AttendanceManager({ classes }) {
    const { joinRequests, attendance, markAttendance, courses } = useData();
    const [selectedClassId, setSelectedClassId] = useState(classes[0]?.id || '');
    const [selectedCourseId, setSelectedCourseId] = useState('');
    const [selectedDate, setSelectedDate] = useState(new Date().toISOString().split('T')[0]);
    const [records, setRecords] = useState({});
    const [statusMessage, setStatusMessage] = useState('');

    // Get courses for the selected class
    const classCourses = courses.filter(c => c.classId === selectedClassId);

    // Get students in the selected class (those who have joined)
    const classStudents = React.useMemo(() => joinRequests
        .filter(req => req.classId === selectedClassId && req.status === 'approved')
        .map(req => ({ id: req.studentId, name: req.studentName })), [joinRequests, selectedClassId]);

    // Auto-select first course when class changes
    React.useEffect(() => {
        if (classCourses.length > 0 && !selectedCourseId) {
            setSelectedCourseId(classCourses[0].id);
        }
    }, [selectedClassId, classCourses, selectedCourseId]);

    // Load existing attendance when class, course, or date changes
    React.useEffect(() => {
        if (!selectedCourseId) return;

        const existingRecord = attendance.find(r =>
            r.classId === selectedClassId &&
            r.courseId === selectedCourseId &&
            r.date === selectedDate
        );

        if (existingRecord) {
            setRecords(existingRecord.records);
        } else {
            // Reset records if no data exists for this date
            const initialRecords = {};
            classStudents.forEach(s => initialRecords[s.id] = 'present'); // Default to present
            setRecords(initialRecords);
        }
        setStatusMessage('');
    }, [selectedClassId, selectedCourseId, selectedDate, attendance, classStudents]);

    const handleStatusChange = (studentId, status) => {
        setRecords(prev => ({ ...prev, [studentId]: status }));
    };

    const handleSave = async () => {
        if (!selectedCourseId) {
            setStatusMessage('Please select a course');
            return;
        }

        // Save with both classId and courseId
        await markAttendance(selectedClassId, selectedCourseId, selectedDate, records);
        setStatusMessage('Attendance saved successfully!');
        setTimeout(() => setStatusMessage(''), 3000);
    };

    <div className="border rounded-lg overflow-hidden">
        <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
                <tr>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
                {courses.map(course => (
                    <div
                        key={course.id}
                        onClick={() => onSelectCourse(course.id)}
                        className={`p-3 rounded-lg border cursor-pointer transition-colors ${selectedCourseId === course.id
                            ? 'border-indigo-500 bg-indigo-50'
                            : 'border-gray-200 hover:bg-gray-50'
                            }`}
                    >
                        <div className="font-medium text-gray-800">{course.name}</div>
                    </div>
                ))}
                {courses.length === 0 && <p className="text-sm text-gray-500 italic">No courses added yet.</p>}
            </div>

            <form onSubmit={handleAddCourse} className="flex gap-2 mt-4">
                <input
                    type="text"
                    value={newCourseName}
                    onChange={(e) => setNewCourseName(e.target.value)}
                    className="flex-1 px-3 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
                    placeholder="New Course Name (e.g. Math)"
                />
                <button
                    type="submit"
                    className="px-3 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm whitespace-nowrap"
                >
                    Add Course
                </button>
            </form>
    </div>
    );
}

function CourseContentEditor({ courseId, courseName, resources, addResource, addAnnouncement, user }) {
    const [resTitle, setResTitle] = useState('');
    const [resType, setResType] = useState('pdf');
    const [announcementText, setAnnouncementText] = useState('');

    const handleAddResource = (e) => {
        e.preventDefault();
        if (!resTitle.trim()) return;
        addResource({
            courseId,
            title: resTitle,
            type: resType,
            url: '#', // Mock URL
        });
        setResTitle('');
    };

    const handlePostAnnouncement = (e) => {
        e.preventDefault();
        if (!announcementText.trim()) return;
        addAnnouncement({
            id: Date.now(),
            title: `Announcement: ${courseName}`,
            content: announcementText,
            date: new Date().toISOString().split('T')[0],
            author: user.name,
            courseId
        });
        setAnnouncementText('');
        alert('Announcement posted!');
    };

    return (
        <div className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
            <h2 className="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Managing: {courseName}</h2>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                {/* Resources */}
                <div>
                    <h3 className="font-medium text-gray-700 mb-3">Resources</h3>
                    <ul className="space-y-2 mb-4">
                        {resources.map(r => (
                            <li key={r.id} className="flex items-center text-sm text-gray-600">
                                <span className={`w-2 h-2 rounded-full mr-2 ${r.type === 'pdf' ? 'bg-red-500' : 'bg-blue-500'}`}></span>
                                {r.title} ({r.type.toUpperCase()})
                            </li>
                        ))}
                        {resources.length === 0 && <li className="text-sm text-gray-400 italic">No resources.</li>}
                    </ul>
                    <form onSubmit={handleAddResource} className="space-y-2">
                        <input
                            type="text"
                            value={resTitle}
                            onChange={(e) => setResTitle(e.target.value)}
                            className="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm"
                            placeholder="Resource Title"
                        />
                        <select
                            value={resType}
                            onChange={(e) => setResType(e.target.value)}
                            className="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm"
                        >
                            <option value="pdf">PDF Document</option>
                            <option value="doc">Word Document</option>
                        </select>
                        <button type="submit" className="w-full px-3 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm hover:bg-gray-200">
                            Upload Resource
                        </button>
                    </form>
                </div>

                {/* Course Announcements */}
                <div>
                    <h3 className="font-medium text-gray-700 mb-3">Post Course Announcement</h3>
                    <form onSubmit={handlePostAnnouncement} className="space-y-2">
                        <textarea
                            value={announcementText}
                            onChange={(e) => setAnnouncementText(e.target.value)}
                            className="w-full px-3 py-2 rounded-lg border border-gray-200 text-sm"
                            placeholder={`Message for ${courseName} students...`}
                            rows="4"
                        />
                        <button type="submit" className="w-full px-3 py-2 bg-indigo-600 text-white rounded-lg text-sm hover:bg-indigo-700">
                            Post Announcement
                        </button>
                    </form>
                </div>
            </div>
        </div>
    );
}

function AttendanceManager({ classes }) {
    const { joinRequests, attendance, markAttendance, courses } = useData();
    const [selectedClassId, setSelectedClassId] = useState(classes[0]?.id || '');
    const [selectedCourseId, setSelectedCourseId] = useState('');
    const [selectedDate, setSelectedDate] = useState(new Date().toISOString().split('T')[0]);
    const [records, setRecords] = useState({});
    const [statusMessage, setStatusMessage] = useState('');

    // Get courses for the selected class
    const classCourses = courses.filter(c => c.classId === selectedClassId);

    // Get students in the selected class (those who have joined)
    const classStudents = React.useMemo(() => joinRequests
        .filter(req => req.classId === selectedClassId && req.status === 'approved')
        .map(req => ({ id: req.studentId, name: req.studentName })), [joinRequests, selectedClassId]);

    // Auto-select first course when class changes
    React.useEffect(() => {
        if (classCourses.length > 0 && !selectedCourseId) {
            setSelectedCourseId(classCourses[0].id);
        }
    }, [selectedClassId, classCourses, selectedCourseId]);

    // Load existing attendance when class, course, or date changes
    React.useEffect(() => {
        if (!selectedCourseId) return;

        const existingRecord = attendance.find(r =>
            r.classId === selectedClassId &&
            r.courseId === selectedCourseId &&
            r.date === selectedDate
        );

        if (existingRecord) {
            setRecords(existingRecord.records);
        } else {
            // Reset records if no data exists for this date
            const initialRecords = {};
            classStudents.forEach(s => initialRecords[s.id] = 'present'); // Default to present
            setRecords(initialRecords);
        }
        setStatusMessage('');
    }, [selectedClassId, selectedCourseId, selectedDate, attendance, classStudents]);

    const handleStatusChange = (studentId, status) => {
        setRecords(prev => ({ ...prev, [studentId]: status }));
    };

    const handleSave = async () => {
        if (!selectedCourseId) {
            setStatusMessage('Please select a course');
            return;
        }

        // Save with both classId and courseId
        await markAttendance(selectedClassId, selectedCourseId, selectedDate, records);
        setStatusMessage('Attendance saved successfully!');
        setTimeout(() => setStatusMessage(''), 3000);
    };

    return (
        <div className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
            <h2 className="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Manage Attendance</h2>

            <div className="mb-4 grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label htmlFor="class-select" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Select Class</label>
                    <select
                        id="class-select"
                        value={selectedClassId}
                        onChange={(e) => {
                            setSelectedClassId(e.target.value);
                            setSelectedCourseId(''); // Reset course when class changes
                        }}
                        className="w-full px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-gray-100"
                    >
                        {classes.length === 0 && <option value="">No classes available</option>}
                        {classes.map(c => (
                            <option key={c.id} value={c.id}>{c.name}</option>
                        ))}
                    </select>
                </div>
                <div>
                    <label htmlFor="course-select" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Select Course</label>
                    <select
                        id="course-select"
                        value={selectedCourseId}
                        onChange={(e) => setSelectedCourseId(e.target.value)}
                        className="w-full px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-gray-100"
                        disabled={!selectedClassId || classCourses.length === 0}
                    >
                        {classCourses.length === 0 ? (
                            <option value="">No courses for this class</option>
                        ) : (
                            <>
                                <option value="">Select a course</option>
                                {classCourses.map(course => (
                                    <option key={course.id} value={course.id}>{course.name}</option>
                                ))}
                            </>
                        )}
                    </select>
                </div>
                <div>
                    <label htmlFor="date-select" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Select Date</label>
                    <input
                        type="date"
                        id="date-select"
                        value={selectedDate}
                        onChange={(e) => setSelectedDate(e.target.value)}
                        className="w-full px-3 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-gray-100"
                    />
                </div>
            </div>

            {selectedCourseId && classStudents.length > 0 && (
                <div className="border rounded-lg overflow-hidden">
                    <table className="min-w-full divide-y divide-gray-200">
                        <thead className="bg-gray-50">
                            <tr>
                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student</th>
                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            </tr>
                        </thead>
                        <tbody className="bg-white divide-y divide-gray-200">
                            {classStudents.map(student => (
                                <tr key={student.id}>
                                    <td className="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{student.name}</td>
                                    <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        <div className="flex space-x-2">
                                            {['present', 'absent', 'late'].map(status => (
                                                <button
                                                    key={status}
                                                    onClick={() => handleStatusChange(student.id, status)}
                                                    className={`px-3 py-1 rounded-full text-xs font-medium capitalize transition-colors ${records[student.id] === status
                                                        ? status === 'present' ? 'bg-green-100 text-green-800 ring-2 ring-green-500'
                                                            : status === 'absent' ? 'bg-red-100 text-red-800 ring-2 ring-red-500'
                                                                : 'bg-yellow-100 text-yellow-800 ring-2 ring-yellow-500'
                                                        : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                                                        }`}
                                                >
                                                    {status}
                                                </button>
                                            ))}
                                        </div>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            )}

            <div className="flex items-center justify-between pt-2">
                <button
                    onClick={handleSave}
                    disabled={!selectedCourseId}
                    className="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors disabled:bg-gray-300 disabled:cursor-not-allowed"
                >
                    Save Attendance
                </button>
                {statusMessage && <span className={`text-sm font-medium ${statusMessage.includes('success') ? 'text-green-600' : 'text-red-600'}`}>{statusMessage}</span>}
            </div>
        </div>
    );
}
